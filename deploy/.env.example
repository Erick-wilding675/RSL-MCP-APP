# D-011, D-013, D-017: Exemplo de configuração do servidor hospedado do RSL.app.
# Copie este arquivo para .env na mesma pasta (cp .env.example .env) e preencha com os seus dados.
# Nunca salve chaves reais em arquivos versionados no git.

# Domínio público que aponta (DNS A/AAAA) para o IP deste servidor
RSL_DOMAIN=rsl.exemplo.org

# Endereço público completo com https:// (deve ter exatamente o mesmo domínio de RSL_DOMAIN)
RSL_PUBLIC_URL=https://rsl.exemplo.org

# Chave gratuita do OpenAlex (obrigatória — crie em https://openalex.org/settings/api e ative pelo e-mail)
OPENALEX_API_KEY=exemplo-chave-openalex-nao-real

# Chave gratuita da Semantic Scholar (opcional — reduz recusas por limite de taxa)
SEMANTIC_SCHOLAR_API_KEY=

# Chave gratuita do NCBI/PubMed (opcional — eleva limite de 3 para 10 req/s)
NCBI_API_KEY=

# E-mail de contato enviado à Crossref para atendimento prioritário no polite pool (opcional)
RSL_CONTACT_EMAIL=contato@exemplo.org
